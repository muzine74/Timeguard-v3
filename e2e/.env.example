# ── Copier ce fichier en .env.local et remplir les valeurs ──────────────────
# .env.local est ignoré par Git (données sensibles).

# URL de l'application Angular déployée
E2E_BASE_URL=http://timeguards.net

# URL directe de l'API ASP.NET Core
# Ajuster selon la configuration IIS du serveur :
#   - Même domaine (reverse proxy IIS) : http://timeguards.net
#   - Port dédié                        : http://timeguards.net:56537
E2E_API_URL=http://timeguards.net

# Ignorer les erreurs de certificat HTTPS (true si certificat auto-signé)
E2E_IGNORE_HTTPS=false

# Timeout par test en ms (augmenter si le serveur est lent)
E2E_TIMEOUT=45000

# Identifiants de test — compte admin
TEST_ADMIN_USER=admin
TEST_ADMIN_PASS=

# Identifiants de test — compte employé
TEST_EMP_USER=employe1
TEST_EMP_PASS=
